    "@sentry/tanstackstart-react": "11.8.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@types/mdx": "2.0.14",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
